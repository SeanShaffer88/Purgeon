{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true
  },
  "files": [
    "src/backend/contracts.js",
    "src/backend/tauri-sys.js",
    "src/backend/system-contracts.d.ts",
    "src/globals.d.ts",
    "packages/purgeon-core/src/internal/contracts.js"
  ],
  "include": [
    "packages/purgeon-core/src/features/*.js",
    "packages/purgeon-core/src/public-runtime.js"
  ]
}
