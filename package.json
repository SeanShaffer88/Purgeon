{
  "name": "sweepuninstall",
  "productName": "SweepUninstall",
  "version": "0.2.0",
  "description": "Windows uninstaller with leftover scanning, install monitoring and backups",
  "author": "Sean Shaffer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeanShaffer88/SweepUninstall.git"
  },
  "homepage": "https://github.com/SeanShaffer88/SweepUninstall",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "electron . --dev",
    "dist": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.seanshaffer.sweepuninstall",
    "productName": "SweepUninstall",
    "copyright": "Copyright © 2026 Sean Shaffer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SweepUninstall-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SweepUninstall-Portable-${version}.${ext}"
    }
  }
}
