{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core APIs, the native open/save file dialogs, and its own title bar buttons (minimize, maximize, close, dragging).",
  "windows": ["main"],
  "permissions": ["core:default", "core:webview:allow-set-webview-zoom", "dialog:allow-open", "dialog:allow-save",
    "notification:default",
    "core:event:default",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-is-maximized"]
}
