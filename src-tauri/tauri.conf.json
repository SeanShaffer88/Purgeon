{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purgeon",
  "version": "1.2.0",
  "identifier": "com.seanshaffer.sweepuninstall",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Purgeon",
        "decorations": false,
        "shadow": true,
        "create": false,
        "visible": false,
        "width": 760,
        "height": 620,
        "minWidth": 520,
        "minHeight": 360,
        "theme": "Dark",
        "backgroundColor": "#0c0c0c",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sean Shaffer",
    "copyright": "Copyright © 2026 Sean Shaffer",
    "shortDescription": "Windows uninstaller with leftover scanning",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "wix": {
        "upgradeCode": "23f1d951-422c-5f4d-90de-749d2729acf9",
        "fragmentPaths": ["windows/task-cleanup.wxs"],
        "componentRefs": ["TaskCleanupRegistration"]
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
